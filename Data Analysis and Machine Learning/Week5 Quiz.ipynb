   "source": [
    "import numpy as np\n",
    "import sympy as sp\n",
    "\n",
    "p = sp.Symbol('p')\n",
    "x = sp.Symbol('x')\n",
    "# x = 7\n",
    "pdf = sp.factorial(10)/(sp.factorial(x) * sp.factorial(10-x)) * p**x * (1-p)**(10-x)\n",
    "a = sp.integrate(pdf, (p, 0, 1))\n",
    "print(a)\n"
   ]
  },
